---
/**
 * Every page: head (title, description, canonical, hreflang, preview tags, CSP, JSON-LD), the
 * header with the navigation and the language switch, the content and the footer. The only script
 * is public/menu.js (Escape and outside clicks close the phone menu); the CSP of the built pages
 * forbids inline scripts, inline styles and other origins.
 */
import { getImage } from 'astro:assets';
import interLatin from '../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import appIcon from '../../../src-tauri/icons/icon.png';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';
import { dicts, type Lang } from '../i18n';
import { website, organization, breadcrumbs, graph } from '../data/jsonld';
import { ROUTES, SITE_NAME, REPO_URL, RELEASES_URL, ISSUES_URL, LICENSE_URL, absolute } from '../data/site.mjs';

type PageKey = keyof typeof ROUTES;

interface Props {
  lang: Lang;
  /** The page in ROUTES; null for the 404 page. */
  page: PageKey | null;
  title: string;
  description: string;
  noindex?: boolean;
  /** Page-specific schema.org nodes; WebSite, Organization and the breadcrumbs are added here. */
  schema?: Record<string, unknown>[];
  /** Responsive preloads of the largest image (the start page's hero), one per media query. */
  preload?: { media: string; srcset: string; sizes: string }[];
  /** The navigation entry to mark as current (defaults to the page). */
  current?: PageKey;
}

const { lang, page, title, description, noindex = false, schema = [], preload = [], current = page } = Astro.props;
const t = dicts[lang];
const other: Lang = lang === 'de' ? 'en' : 'de';
const path = page ? ROUTES[page][lang] : null;
const canonical = path ? absolute(path) : null;
// Link preview per page (src/pages/og/[page].jpg.ts); the 404 page uses the start page's.
const ogImage = absolute(`/og/${page ?? 'home'}.jpg`);
const r = (key: PageKey, l: Lang = lang) => ROUTES[key][l];

const favicon = await getImage({ src: appIcon, format: 'png', width: 64 });
const touchIcon = await getImage({ src: appIcon, format: 'png', width: 180 });
const brandIcon = await getImage({ src: appIcon, format: 'png', width: 56 });

// One JSON-LD graph per indexable page: WebSite and Organization everywhere, the page's own
// nodes (SoftwareApplication on the start page), and a BreadcrumbList below the start page.
const crumbName: Record<PageKey, string> = { home: '', example: t.nav.example, download: t.nav.download, changelog: t.nav.changelog, imprint: t.footer.imprint, privacy: t.footer.privacy };
const nodes = [website(lang), await organization(), ...schema, ...(page && page !== 'home' ? [breadcrumbs(lang, page, crumbName[page], SITE_NAME)] : [])];
const jsonLd = noindex ? null : graph(nodes);

const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "img-src 'self'",
  "style-src 'self'",
  "font-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
  'upgrade-insecure-requests',
].join('; ');

const nav: { key: PageKey; label: string; href: string }[] = [
  { key: 'home', label: t.nav.features, href: `${r('home')}#funktionen` },
  { key: 'example', label: t.nav.example, href: r('example') },
  { key: 'download', label: t.nav.download, href: r('download') },
  { key: 'changelog', label: t.nav.changelog, href: r('changelog') },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    {page && !noindex && <link rel="alternate" hreflang="de" href={absolute(r(page, 'de'))} />}
    {page && !noindex && <link rel="alternate" hreflang="en" href={absolute(r(page, 'en'))} />}
    {page && !noindex && <link rel="alternate" hreflang="x-default" href={absolute(r(page, 'de'))} />}
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={favicon.src} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    {preload.map((p) => <link rel="preload" as="image" type="image/avif" media={p.media} imagesrcset={p.srcset} imagesizes={p.sizes} fetchpriority="high" />)}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline src="/menu.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#inhalt">{t.skip}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={r('home')} aria-label={t.nav.home}>
          <img src={brandIcon.src} width="28" height="28" alt="" loading="eager" />
          <span>{SITE_NAME}</span>
        </a>
        <nav class="nav-desktop" aria-label={t.nav.label}>
          <ul class="nav">
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={current === n.key && n.key !== 'home' ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
            {page && (
              <li>
                <a class="lang" href={r(page, other)} hreflang={other} lang={other} aria-label={t.nav.switchLabel}>{t.nav.switchTo}</a>
              </li>
            )}
          </ul>
        </nav>
        <div class="header-phone">
          {page && <a class="lang-short" href={r(page, other)} hreflang={other} lang={other} aria-label={t.nav.switchLabel}>{t.nav.switchShort}</a>}
          <details class="menu">
            <summary>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path class="bars" d="M3 6h14M3 10h14M3 14h14" /><path class="cross" d="M5 5l10 10M15 5L5 15" /></svg>
              <span>{t.nav.menu}</span>
            </summary>
            <nav class="menu-panel" aria-label={t.nav.label}>
              <ul>
                {nav.map((n) => (
                  <li>
                    <a href={n.href} aria-current={current === n.key && n.key !== 'home' ? 'page' : undefined}>{n.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" aria-label={t.footer.label}>
      <div class="wrap footer-grid">
        <div>
          <p>{t.footer.tagline}</p>
        </div>
        <div>
          <h2>{t.footer.site}</h2>
          <ul>
            <li><a href={r('example')}>{t.nav.example}</a></li>
            <li><a href={r('download')}>{t.nav.download}</a></li>
            <li><a href={r('changelog')}>{t.nav.changelog}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t.footer.project}</h2>
          <ul>
            <li><a href={REPO_URL} rel="noopener">{t.footer.source}</a></li>
            <li><a href={RELEASES_URL} rel="noopener">{t.footer.releases}</a></li>
            <li><a href={ISSUES_URL} rel="noopener">{t.footer.issues}</a></li>
            <li><a href={LICENSE_URL} rel="noopener">{t.footer.license}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t.footer.legal}</h2>
          <ul>
            <li><a href={r('imprint')}>{t.footer.imprint}</a></li>
            <li><a href={r('privacy')}>{t.footer.privacy}</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
