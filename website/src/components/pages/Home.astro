---
import Base from '../../layouts/Base.astro';
import Shot from '../Shot.astro';
import { dicts, fill, type Lang } from '../../i18n';
import { getDownloads, available } from '../../data/release.mjs';
import { ROUTES, REPO_URL, ISSUES_URL, LATEST_URL } from '../../data/site.mjs';
import { softwareApplication } from '../../data/jsonld';
import { shot, crop, type ShotName } from '../../data/shots';
import { variant, DESKTOP_WIDTHS, PHONE_WIDTHS, PHONE, PHONE_SIZES } from '../../data/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const h = t.home;
const d = await getDownloads();

const FEATURE_SHOTS: ShotName[] = ['02-grundriss', '08-ansichten', '04-3d-uebersicht', '10-katalog-vorschau', '11-operator-verschieben', '12-raum-wand'];
const FEATURE_SIZES = '(min-width: 1244px) 680px, (min-width: 960px) 56vw, calc(100vw - 32px)';
const more = h.features.more.filter((m) => available(d, 'since' in m ? m.since : undefined));

// The hero is the largest paint: preload the one variant the browser will show (same files as Shot).
const HERO_SIZES = '(min-width: 1244px) 1180px, calc(100vw - 32px)';
const [heroDark, heroLight, heroPhone] = await Promise.all([
  variant(shot('01-alle-ansichten'), DESKTOP_WIDTHS, 1200),
  variant(shot('14-hell-alle-ansichten'), DESKTOP_WIDTHS, 1200),
  variant(crop('05-3d-kochinsel')!, PHONE_WIDTHS, 720),
]);
const preload = [
  { media: PHONE, srcset: heroPhone.avif, sizes: PHONE_SIZES },
  { media: '(min-width: 960px) and (prefers-color-scheme: dark)', srcset: heroDark.avif, sizes: HERO_SIZES },
  { media: '(min-width: 960px) and (prefers-color-scheme: light)', srcset: heroLight.avif, sizes: HERO_SIZES },
];

const app = await softwareApplication(lang, d, {
  description: t.meta.home.description,
  features: [...h.features.items.map((f) => f.title), ...more.map((m) => m.title)],
  shots: [['01-alle-ansichten', h.heroAlt], ...FEATURE_SHOTS.map((s, i): [ShotName, string] => [s, h.features.items[i].alt])],
});
---
<Base lang={lang} page="home" title={t.meta.home.title} description={t.meta.home.description} schema={[app]} preload={preload}>
  <section class="hero" aria-labelledby="titel">
    <div class="wrap">
      <div class="hero-text">
        <p class="eyebrow">{h.eyebrow}</p>
        <h1 id="titel">{h.title}</h1>
        <p class="lead">{h.lead}</p>
        <div class="buttons">
          <a class="btn btn-primary" href={ROUTES.download[lang]}>{h.download}</a>
          <a class="btn btn-secondary" href={ROUTES.example[lang]}>{h.example}</a>
        </div>
        <p class="facts">
          {d.latest
            ? <a href={ROUTES.changelog[lang]}>{fill(h.version, { v: d.latest.version })}</a>
            : <a href={LATEST_URL} rel="noopener">GitHub</a>}
          {h.facts.map((f) => <><span class="sep" aria-hidden="true">·</span><span>{f}</span></>)}
        </p>
      </div>
      <Shot name="01-alle-ansichten" light="14-hell-alle-ansichten" phone="05-3d-kochinsel" alt={h.heroAlt} sizes={HERO_SIZES} eager />
    </div>
  </section>

  <section class="section section-alt" id="fuer-wen" aria-labelledby="fuer-wen-titel">
    <div class="wrap">
      <div class="section-head">
        <h2 id="fuer-wen-titel">{h.audience.title}</h2>
      </div>
      <ul class="cards">
        {h.audience.items.map((a) => (
          <li class="card">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="funktionen" aria-labelledby="funktionen-titel">
    <div class="wrap">
      <div class="section-head">
        <h2 id="funktionen-titel">{h.features.title}</h2>
        <p class="lead">{h.features.intro}</p>
      </div>
      <div class="features">
        {h.features.items.map((f, i) => (
          <div class="feature">
            <div class="feature-text">
              <h3><span class="pos" aria-hidden="true">{i + 1}</span>{f.title}</h3>
              <p>{f.text}</p>
            </div>
            <figure>
              <Shot name={FEATURE_SHOTS[i]} light={FEATURE_SHOTS[i] === '04-3d-uebersicht' ? '15-hell-3d' : undefined} alt={f.alt} sizes={FEATURE_SIZES} />
              <figcaption class="phone-only">{f.caption}</figcaption>
            </figure>
          </div>
        ))}
      </div>
      <h3 class="more-title">{h.features.moreTitle}</h3>
      <ul class="more">
        {more.map((m) => (
          <li>
            <h4>{m.title}</h4>
            <p>{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt" id="open-source" aria-labelledby="open-source-titel">
    <div class="wrap split">
      <div>
        <h2 id="open-source-titel">{h.open.title}</h2>
        <p class="lead">{h.open.text}</p>
        <div class="buttons">
          <a class="btn btn-secondary" href={REPO_URL} rel="noopener">{h.open.source}</a>
          <a class="btn btn-secondary" href={ISSUES_URL} rel="noopener">{h.open.issues}</a>
        </div>
      </div>
      <div>
        <h2 id="ausprobieren-titel">{h.cta.title}</h2>
        <p class="lead">{h.cta.text}</p>
        <div class="buttons">
          <a class="btn btn-primary" href={ROUTES.download[lang]}>{h.cta.button}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
