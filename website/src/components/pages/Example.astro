---
import Base from '../../layouts/Base.astro';
import Shot from '../Shot.astro';
import { dicts, type Lang } from '../../i18n';
import { getDownloads, button, formatSize } from '../../data/release.mjs';
import { ANCHORS, ROUTES } from '../../data/site.mjs';
import { EXPORTS } from '../../data/exports.mjs';
import type { ShotName } from '../../data/shots';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const e = t.example;
const d = await getDownloads();
// The file in the page's language first, then the other one; both name their size.
const files = (lang === 'de'
  ? [[button(d, 'example-de'), e.fileDe], [button(d, 'example-en'), e.fileEn]]
  : [[button(d, 'example-en'), e.fileEn], [button(d, 'example-de'), e.fileDe]]) as [ReturnType<typeof button>, string][];

const GALLERY: ShotName[] = [
  '03-grundriss-kochinsel-auswahl', '04-3d-uebersicht', '05-3d-kochinsel', '06-3d-begehen',
  '07-3d-von-oben', '09-ansicht-nord', '13-inspektor-kombidaempfer', '16-ansicht-schnitttiefe',
];
// Two columns from 860 px: half of the 1180 px page less half the 24 px gap.
const SIZES = '(min-width: 1244px) 578px, (min-width: 860px) calc(50vw - 44px), (min-width: 720px) calc(100vw - 64px), calc(100vw - 32px)';
const A = Object.fromEntries(Object.entries(ANCHORS).map(([k, v]) => [k, v[lang]])) as Record<keyof typeof ANCHORS, string>;
const plan = EXPORTS.find((x) => x.name === 'grundriss.svg')!;
---
<Base lang={lang} page="example" title={t.meta.example.title} description={t.meta.example.description}>
  <div class="wrap page-head">
    <h1>{e.title}</h1>
    <p class="lead">{e.lead}</p>
  </div>
  <div class="page-body">
    <div class="wrap">
      <div class="split">
        <section class="block" id={A.facts} aria-labelledby={`${A.facts}-h`}>
          <h2 id={`${A.facts}-h`}>{e.factsTitle}</h2>
          <dl class="kv">
            {e.facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          </dl>
        </section>
        <section class="block" id={A.open} aria-labelledby={`${A.open}-h`}>
          <h2 id={`${A.open}-h`}>{e.openTitle}</h2>
          <p class="muted">{e.openText}</p>
          <div class="buttons">
            {files.map(([f, label], i) => (
              <a class:list={['btn', 'btn-stack', i === 0 ? 'btn-primary' : 'btn-secondary']} href={f.href} rel="noopener" title={f.file ?? undefined}>
                <span>{label}</span>
                {f.size && <small>.kplan, {formatSize(f.size, lang)}</small>}
              </a>
            ))}
          </div>
          <p class="muted">{e.noApp} <a href={ROUTES.download[lang]}>{e.noAppLink}</a></p>
        </section>
      </div>

      <section class="block" id={A.gallery} aria-labelledby={`${A.gallery}-h`}>
        <h2 id={`${A.gallery}-h`}>{e.galleryTitle}</h2>
        <div class="figures">
          {GALLERY.map((name, i) => (
            <figure>
              {/* The first picture is the largest paint on desktops: loaded at once, not lazily. */}
              <Shot name={name} alt={e.gallery[i]} sizes={SIZES} eager={i === 0} />
              <figcaption aria-hidden="true">{e.gallery[i]}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="block" id={A.exports} aria-labelledby={`${A.exports}-h`}>
        <h2 id={`${A.exports}-h`}>{e.exportsTitle}</h2>
        <p class="muted measure">{e.exportsText}</p>
        <figure>
          <a href={`/beispiel/${plan.name}`} class="paper">
            <img src={`/beispiel/${plan.name}`} width={plan.width} height={plan.height} alt={e.planAlt} loading="lazy" decoding="async" />
          </a>
        </figure>
        <ul class="files">
          {e.exports.map(([file, text]) => {
            const x = EXPORTS.find((f) => f.name === file)!;
            return <li><a href={`/beispiel/${file}`}>{file}</a> <span class="muted">{text}, {formatSize(x.size, lang)}</span></li>;
          })}
        </ul>
      </section>
    </div>
  </div>
</Base>
