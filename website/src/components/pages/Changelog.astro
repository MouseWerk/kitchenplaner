---
import Base from '../../layouts/Base.astro';
import { dicts, fill, type Lang } from '../../i18n';
import { getDownloads, formatDate } from '../../data/release.mjs';
import { readNotes } from '../../data/notes.mjs';
import { ROUTES, absolute } from '../../data/site.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const c = t.changelog;
const d = await getDownloads();
const notes = await readNotes();
const sectionTitle = (s: string) => (c.sections as Record<string, string>)[s] ?? s;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kitchenplaner', item: absolute(ROUTES.home[lang]) },
    { '@type': 'ListItem', position: 2, name: c.title, item: absolute(ROUTES.changelog[lang]) },
  ],
};
---
<Base lang={lang} page="changelog" title={t.meta.changelog.title} description={t.meta.changelog.description} schema={[crumbs]}>
  <div class="wrap page-head">
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
  </div>
  <div class="page-body">
    <div class="wrap">
      {notes.map((n) => {
        const rel = d.byTag.get(`v${n.version}`);
        const id = `v${n.version.replace(/\./g, '-')}`;
        return (
          <article class="release" id={id} aria-labelledby={`${id}-titel`} lang="en">
            <h2 id={`${id}-titel`} lang={lang}>{fill(c.version, { v: n.version })}</h2>
            <p class="release-meta" lang={lang}>
              <span>{rel?.publishedAt ? fill(c.released, { date: formatDate(rel.publishedAt, lang) }) : c.upcoming}</span>
              {rel && <a href={rel.htmlUrl} rel="noopener">{c.onGithub}</a>}
            </p>
            {n.intro.map((p) => <p set:html={p} />)}
            {n.sections.map((s) => (
              <>
                <h3 lang={lang}>{sectionTitle(s.title)}</h3>
                {s.paragraphs.map((p) => <p set:html={p} />)}
                {s.items.length > 0 && <ul>{s.items.map((i) => <li set:html={i} />)}</ul>}
              </>
            ))}
          </article>
        );
      })}
    </div>
  </div>
</Base>
