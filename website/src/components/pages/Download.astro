---
import Base from '../../layouts/Base.astro';
import { dicts, fill, type Lang } from '../../i18n';
import { getDownloads, button, formatSize, formatDate, available } from '../../data/release.mjs';
import { ROUTES, RELEASES_URL } from '../../data/site.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const dl = t.download;
const d = await getDownloads();
const v = d.latest?.version ?? '<version>';
const vars = { deb: button(d, 'linux-deb').file ?? `Kitchenplaner_${v}_amd64.deb`, appimage: button(d, 'linux-appimage').file ?? `Kitchenplaner_${v}_amd64.AppImage` };

const platforms = [
  { id: 'windows', text: dl.windows, primary: button(d, 'win-setup'), secondary: null },
  { id: 'macos', text: dl.mac, primary: button(d, 'mac-dmg'), secondary: button(d, 'mac-app') },
  { id: 'linux', text: dl.linux, primary: button(d, 'linux-appimage'), secondary: button(d, 'linux-deb') },
] as const;
const sums = button(d, 'checksums');
// The button names the variant and size ("x64-setup.exe, 1,9 MB"); the whole file name is the title.
const meta = (b: { file: string | null; size: number | null }) => [b.file?.replace(/^Kitchenplaner_[\d.]+_/, ''), formatSize(b.size, lang)].filter(Boolean).join(', ');
---
<Base lang={lang} page="download" title={t.meta.download.title} description={t.meta.download.description}>
  <div class="wrap page-head">
    <h1>{dl.title}</h1>
    <p class="lead">
      {dl.lead}
      {' '}
      {d.latest ? fill(dl.current, { v: d.latest.version, date: formatDate(d.latest.publishedAt, lang) }) : dl.currentUnknown}
    </p>
    <div class="notice" role="note">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="10" cy="10" r="8" /><path d="M10 6v5M10 14v.01" stroke-linecap="round" /></svg>
      <p>{dl.unsigned}</p>
    </div>
  </div>
  <div class="page-body">
    <div class="wrap">
      <div class="platforms">
        {platforms.map((p) => (
          <section class="platform" id={p.id} aria-labelledby={`${p.id}-titel`}>
            <h2 id={`${p.id}-titel`}>{p.text.title}</h2>
            <p class="muted">{p.text.req}</p>
            <a class="btn btn-primary" href={p.primary.href} rel="noopener" title={p.primary.file ?? undefined}>
              <span>{p.text.primary}</span>
              {p.primary.file && <small class="file">{meta(p.primary)}</small>}
            </a>
            {p.secondary && 'secondary' in p.text && (
              <a class="btn btn-secondary" href={p.secondary.href} rel="noopener" title={p.secondary.file ?? undefined}>
                <span>{p.text.secondary}</span>
                {p.secondary.file && <small class="file">{meta(p.secondary)}</small>}
              </a>
            )}
            <ol class="steps">
              {p.text.steps.map((s) => (
                <li>
                  {s.text}
                  {'cmd' in s && s.cmd && <code class="cmd" tabindex="0">{fill(s.cmd, vars)}</code>}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <div class="tiles">
        <section class="block" id="pruefsummen" aria-labelledby="pruefsummen-titel">
          <h2 id="pruefsummen-titel">{dl.checksums.title}</h2>
          <p class="muted">{dl.checksums.text}</p>
          <code class="cmd" tabindex="0">{dl.checksums.cmd}</code>
          <p><a href={sums.href} rel="noopener">{dl.checksums.file}</a></p>
        </section>
        {available(d, dl.updates.since) && (
          <section class="block" id="updates" aria-labelledby="updates-titel">
            <h2 id="updates-titel">{dl.updates.title}</h2>
            <p class="muted">{dl.updates.text}</p>
          </section>
        )}
        <section class="block" aria-labelledby="beispiel-titel">
          <h2 id="beispiel-titel">{dl.example.title}</h2>
          <p class="muted">{dl.example.text}</p>
          <p><a href={ROUTES.example[lang]}>{dl.example.link}</a></p>
          <p class="muted">{dl.older}: <a href={RELEASES_URL} rel="noopener">{dl.releases}</a></p>
        </section>
      </div>
    </div>
  </div>
</Base>
