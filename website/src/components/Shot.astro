---
/**
 * A screenshot of the app as AVIF with a WebP fallback, in several widths, art-directed:
 * - below 960 px (phones and tablets, where it spans the column) a crop (src/data/crops.mjs) of the region that reads on a phone, by default
 *   the crop of `name`, or of `phone` when the phone shows another picture (the hero);
 * - with `light`, people whose system is in light mode get the light-design screenshot instead;
 * - otherwise the whole app window.
 * The browser downloads only the one that applies. The hero image is the only eager one.
 */
import { shot, crop, type ShotName } from '../data/shots';
import { variant, DESKTOP_WIDTHS, PHONE_WIDTHS, PHONE, PHONE_SIZES } from '../data/images';

interface Props {
  name: ShotName;
  light?: ShotName;
  /** The screenshot whose crop phones get; false shows the whole screenshot on phones too. */
  phone?: ShotName | false;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { name, light, phone = name, alt, sizes, eager = false } = Astro.props;
const dark = await variant(shot(name), DESKTOP_WIDTHS, 1200);
const lite = light ? await variant(shot(light), DESKTOP_WIDTHS, 1200) : null;
const phoneSrc = phone ? crop(phone) : null;
const mob = phoneSrc ? await variant(phoneSrc, PHONE_WIDTHS, 720) : null;
const LIGHT = '(prefers-color-scheme: light)';
---
<picture class="shot">
  {mob && <source media={PHONE} type="image/avif" srcset={mob.avif} sizes={PHONE_SIZES} width={mob.w} height={mob.h} />}
  {mob && <source media={PHONE} type="image/webp" srcset={mob.webp} sizes={PHONE_SIZES} width={mob.w} height={mob.h} />}
  {lite && <source media={LIGHT} type="image/avif" srcset={lite.avif} sizes={sizes} width={lite.w} height={lite.h} />}
  {lite && <source media={LIGHT} type="image/webp" srcset={lite.webp} sizes={sizes} width={lite.w} height={lite.h} />}
  <source type="image/avif" srcset={dark.avif} sizes={sizes} width={dark.w} height={dark.h} />
  <img
    src={dark.src}
    srcset={dark.webp}
    sizes={sizes}
    width={dark.w}
    height={dark.h}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>
