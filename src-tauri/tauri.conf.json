{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitchenplaner",
  "version": "0.2.1",
  "identifier": "de.mousewerk.kitchenplaner",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kitchenplaner",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "MouseWerk",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Maurice Kleindienst",
    "license": "MIT",
    "shortDescription": "Planung von Profi- und Gastroküchen",
    "longDescription": "Plane gewerbliche Küchen im Grundriss, in vier Ansichten und in 3D, mit Geräteliste, Anschlusswerten, Prüfung und Export als SVG, DXF, PNG und CSV.",
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["kplan"],
        "name": "Kitchenplaner-Projekt",
        "description": "Kitchenplaner-Projekt",
        "role": "Editor",
        "mimeType": "application/x-kitchenplaner"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Kitchenplaner",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4QjlFQkQyMDQ2RkM0MzgKUldRNHhHOEUwdXU1S1BXYTNrUGcvNGY0clBCNGJMUGJGV24xcldmOWVnTlFtaXU0QmpDU29NVnoK",
      "endpoints": ["https://github.com/MouseWerk/kitchenplaner/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
